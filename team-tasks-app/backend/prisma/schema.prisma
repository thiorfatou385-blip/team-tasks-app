generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  manager
  lead_dev
  developer
}

enum TaskStatus {
  predefined
  assigned
  in_progress
  done
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  password        String
  role            Role      @default(developer)
  githubUsername  String?   @map("github_username")
  isActive        Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  managedProjects Project[] @relation("manager")
  leadProjects    Project[] @relation("leadDev")
  tasks           Task[]    @relation("assignee")
  memberProjects  Project[] @relation("members")

  @@map("users")
}

model Project {
  id                  Int      @id @default(autoincrement())
  name                String
  description         String?
  managerId           Int      @map("manager_id")
  leadDevId           Int      @map("lead_dev_id")
  githubRepo          String?  @map("github_repo")
  githubDefaultBranch String   @default("main") @map("github_default_branch")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  manager             User     @relation("manager", fields: [managerId], references: [id], onDelete: Cascade)
  leadDev             User     @relation("leadDev", fields: [leadDevId], references: [id], onDelete: Cascade)
  tasks               Task[]
  members             User[]   @relation("members")

  @@map("projects")
}

model Task {
  id           Int        @id @default(autoincrement())
  projectId    Int        @map("project_id")
  title        String
  description  String?
  status       TaskStatus @default(predefined)
  assignedTo   Int?       @map("assigned_to")
  startDate    DateTime   @map("start_date")
  assignedAt   DateTime?  @map("assigned_at")
  startedAt    DateTime?  @map("started_at")
  completedAt  DateTime?  @map("completed_at")
  githubBranch String?    @map("github_branch")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?      @relation("assignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@map("tasks")
}
